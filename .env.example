# Copy this to .env and fill it in. Never commit .env.
# On Vercel, set these in Project Settings > Environment Variables instead.

ENVIRONMENT=production

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Docker Compose only (the database container's password).
POSTGRES_PASSWORD=

# Set automatically by Vercel's Neon integration. Any postgres:// URL works;
# the app converts it for its async driver.
# DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Set to false only for plain http on something other than localhost.
COOKIE_SECURE=true
# Only needed if the frontend is served from a different origin to the API.
CORS_ORIGINS=http://localhost:8080

# Optional: the AI tutor. Leave blank to use the offline tutor.
# Any OpenAI-compatible API works (OpenAI, Azure OpenAI, OpenRouter, Ollama...).
LLM_API_KEY=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
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: natural-sounding voices. Leave blank to use the browser's voices.
ELEVENLABS_API_KEY=a812d7f6bffacd1683c05550229a3aa0d7389abdc2a80f9967377c592c9e38a9
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: shared rate limiting across instances (Upstash Redis).
# Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which also work.
# REDIS_REST_URL=
# REDIS_REST_TOKEN=

LOG_LEVEL=INFO
